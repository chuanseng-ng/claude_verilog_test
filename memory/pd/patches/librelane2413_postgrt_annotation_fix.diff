+++ b/librelane/scripts/openroad/sta/corner.tcl	2026-09-16 05:47:38.413576196 +0700
@@ -35,7 +35,24 @@
 
     # Internal API- brittle
     if { [grt::have_routes] } {
+        # claude_verilog_test local patch (bead 8f3, 2026-09-16): grt::have_routes is true
+        # whenever the loaded ODB has PERSISTED routing-guide data from an earlier GlobalRouting
+        # step, but per bead je8 (bd memory openroad-grt-parasitics-need-insession-route),
+        # estimate_parasitics -global_routing cannot actually recover real parasitics from that
+        # persisted state alone -- it needs a live in-session global_route. Optional and
+        # backward-compatible: unset (the default) is BYTE-IDENTICAL to upstream (same
+        # `estimate_parasitics -global_routing` call as always, on whatever GRT state the ODB
+        # already carries). Mirrors common/grt.tcl's own setup exactly by sourcing it directly,
+        # rather than re-deriving routing layers / layer adjustments / GRT_* settings separately.
+        if { [info exists ::env(STA_POSTGRT_INSESSION_GRT)] && $::env(STA_POSTGRT_INSESSION_GRT) == 1 } {
+            source $::env(SCRIPTS_DIR)/openroad/common/grt.tcl
+        }
         estimate_parasitics -global_routing
+        # claude_verilog_test local patch (bead 8f3, 2026-09-16): always-on annotation gate --
+        # see ol_check_postgrt_parasitic_annotation in common/io.tcl (sourced above). Deliberately
+        # NOT applied to the -placement branch below (per bead 8f3: placement-stage STA is
+        # unaffected and was never claiming GRT-derived parasitics).
