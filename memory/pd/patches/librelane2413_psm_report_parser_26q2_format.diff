+    # claude_verilog_test local patch (2026-09-13). The original turned the
+    # report into YAML, which only matches the space-indented layout this
+    # function was written for (still produced by pdn.tcl's own fallback file).
+    # The OpenROAD 26Q2 binary shimmed into this flow writes:
+    #
+    #     violation type: Unconnected shape
+    #     <TAB>srcs: net:VSS
+    #     <TAB>bbox = (x0, y0) - (x1, y1) on Layer M1
+    #
+    # Tab indentation is illegal YAML (ScannerError at line 2, column 1), and even
+    # re-indented, "srcs: net:VSS" is a scalar -- len() of it counts characters.
+    # This counts source entries line by line instead, so all three inputs work:
+    #   empty file (grid check passed)            -> 0
+    #   pdn.tcl fallback ("srcs:" + "- N/A" item) -> 1
+    #   26Q2 report (one "srcs: <src>" per entry) -> number of sources
+    # It only surfaced once pdn.tcl started committing a partial grid: before
+    # that, a failed pdngen left no grid and the YAML-valid fallback file.
+    count = 0
+    in_srcs = False
+    for raw in rpt:
+        line = raw.strip()
+        if not line:
+            continue
+        if raw.startswith("violation type:"):
+            in_srcs = False
+            continue
+        if line.startswith("srcs:"):
+            rest = line[len("srcs:"):].strip()
+            if rest:
+                count += len(rest.split())
+                in_srcs = False
+            else:
+                in_srcs = True
+            continue
+        if line.startswith("bbox"):
+            in_srcs = False
+            continue
+        if in_srcs and line.startswith("- "):
+            count += 1
+    return count
 
 
