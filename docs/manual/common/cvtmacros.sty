\newcommand{\partialmark}{\cvttag{cvtpartial}{PARTIAL}}
\newcommand{\notemark}{\cvttag{cvtnote}{NOTE}}
\newcommand{\openmark}{\cvttag{cvtopen}{OPEN}}
