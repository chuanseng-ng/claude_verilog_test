% ---- Paths and identifiers -------------------------------------------
% Breakable monospace text. Underscores and other characters are safe.
\ExplSyntaxOn
\cs_new:Nn \cvt_char:n
  {
    \str_case:nnF {#1}
      {
        {/}{/\penalty0\relax}
        {_}{\char`\_\penalty0\relax}
        {.}{.\penalty0\relax}
        {-}{\char`\-\penalty0\relax}
        {,}{,\penalty0\relax}
        {=}{=\penalty0\relax}
        {:}{:\penalty0\relax}
      }
      {#1\penalty800\relax}% last resort: a long hash or word may break anywhere
  }
\cs_new:Nn \cvt_text:n
  { \str_map_inline:nn {#1} { \cvt_char:n {##1} } }
\NewDocumentCommand{\cvtmono}{m}
  { \begingroup \ttfamily \cvt_text:n {#1} \endgroup }
\ExplSyntaxOff
\newcommand{\src}[1]{\cvtmono{#1}}
\newcommand{\code}[1]{\cvtmono{#1}}
\newcommand{\runid}[1]{\cvtmono{#1}}
% Bead identifier: monospace and an entry in the bead index of the book.
\newcommand{\bead}[1]{\cvtmono{#1}\index[\cvtbeadindex]{#1@\texttt{#1}}}
\newcommand{\cvtrepo}{https://github.com/chuanseng-ng/claude_verilog_test}
\newcommand{\ghref}[1]{\href{\cvtrepo/issues/#1}{GH~\##1}}
\newcommand{\prref}[1]{\href{\cvtrepo/pull/#1}{PR~\##1}}

% ---- Boxes -----------------------------------------------------------
\mdfsetup{skipabove=0.8\baselineskip,skipbelow=0.8\baselineskip}
\newmdenv[linewidth=1.2pt,topline=false,bottomline=false,rightline=false,
  linecolor=cvtwarn,backgroundcolor=cvtwarn!6,innerleftmargin=8pt,
  innertopmargin=4pt,innerbottommargin=4pt]{cvt@warningbox}
\newmdenv[linewidth=1.2pt,topline=false,bottomline=false,rightline=false,
  linecolor=cvtbad,backgroundcolor=cvtbad!6,innerleftmargin=8pt,
  innertopmargin=4pt,innerbottommargin=4pt]{cvt@cautionbox}
\newmdenv[linewidth=1.2pt,topline=false,bottomline=false,rightline=false,
  linecolor=cvtwip,backgroundcolor=cvtwip!6,innerleftmargin=8pt,
  innertopmargin=4pt,innerbottommargin=4pt]{cvt@notebox}

\newcommand{\cvtcaption}[1]{{\sffamily\scriptsize\color{black!65}#1}\par
  \vspace{2pt}}
% Number that a heading had in its original file; the heading title no longer prints it.
\newcommand{\origsec}[1]{\par\nobreak\cvtcaption{(original section #1)}\nobreak}
% Moved and record text sit between two marker lines. The text is not boxed, so it
% breaks across pages and may hold longtables, listings and landscape pages.
\newcommand{\cvt@markrule}{\par\nobreak\noindent
  {\color{black!45}\rule{\linewidth}{0.4pt}}\par\nobreak}
% Text moved verbatim from a source file. The body is normal LaTeX.
\NewDocumentEnvironment{relocated}{m}
  {\par\addvspace{0.6\baselineskip}\cvt@markrule
   \cvtcaption{Moved from \src{#1}}\nobreak}
  {\par\nobreak\cvtcaption{End of moved text}\cvt@markrule
   \addvspace{0.6\baselineskip}}
% Historical text in the Changes record, with an optional date.
\NewDocumentEnvironment{record}{o}
  {\par\addvspace{0.6\baselineskip}\cvt@markrule
   \cvtcaption{Record\IfValueT{#1}{ \textbullet\ #1}}\nobreak}
  {\par\nobreak\cvtcaption{End of record}\cvt@markrule
   \addvspace{0.6\baselineskip}}
\newenvironment{warningbox}
  {\begin{cvt@warningbox}\textbf{Warning.}\ }{\end{cvt@warningbox}}
\newenvironment{cautionbox}
  {\begin{cvt@cautionbox}\textbf{Caution.}\ }{\end{cvt@cautionbox}}
\newenvironment{notebox}
  {\begin{cvt@notebox}\textbf{Note.}\ }{\end{cvt@notebox}}
\newenvironment{procedure}
  {\begin{enumerate}}{\end{enumerate}}

% ---- Requirements -----------------------------------------------------
% \begin{requirement}{DS-CDC-020}{Short title}[verify={refs}] ... \end{requirement}
% The last argument is never typeset. tools/docs/check_requirements.py reads it.
% The ID DS-CDC-020 defines the label ds:req:cdc-020. \reqref{DS-CDC-020} refers to it.
\definecolor{cvtreq}{HTML}{00695C}
\newcounter{cvtreq}
\newmdenv[linewidth=1.6pt,topline=false,bottomline=false,rightline=false,
  linecolor=cvtreq,backgroundcolor=cvtreq!5,innerleftmargin=8pt,
  innertopmargin=4pt,innerbottommargin=4pt]{cvt@reqbox}
\newmdenv[linewidth=1.2pt,topline=false,bottomline=false,rightline=false,
  linecolor=cvtnote,backgroundcolor=cvtnote!6,innerleftmargin=8pt,
  innertopmargin=4pt,innerbottommargin=4pt]{cvt@rationalebox}
\ExplSyntaxOn
\tl_new:N \l_cvt_req_label_tl
\seq_new:N \l_cvt_req_seq
\tl_new:N \l_cvt_req_book_tl
\cs_new_protected:Npn \cvt_req_set_label:n #1
  {
    \tl_set:Nx \l_cvt_req_label_tl { \str_lowercase:n {#1} }
    \exp_args:NNnV \seq_set_split:Nnn \l_cvt_req_seq { - } \l_cvt_req_label_tl
    \seq_pop_left:NN \l_cvt_req_seq \l_cvt_req_book_tl
    \tl_set:Nx \l_cvt_req_label_tl
      { \l_cvt_req_book_tl : req : \seq_use:Nn \l_cvt_req_seq { - } }
  }
\NewDocumentCommand{\cvt@reqlabel}{m}
  { \cvt_req_set_label:n {#1} \exp_args:NV \label \l_cvt_req_label_tl }
\NewDocumentCommand{\reqref}{m}
  { \cvt_req_set_label:n {#1} \exp_args:NV \ref \l_cvt_req_label_tl }
\ExplSyntaxOff
\NewDocumentEnvironment{requirement}{m m O{}}
  {\begin{cvt@reqbox}%
   \refstepcounter{cvtreq}\phantomsection
   \def\@currentlabel{\texttt{#1}}%
   \cvt@reqlabel{#1}%
   \addcontentsline{req}{cvtreq}{\protect\texttt{#1}\quad #2}%
   \textbf{\ttfamily #1}\quad\textbf{#2}\par\nobreak\smallskip}
  {\end{cvt@reqbox}}
\newcommand*{\l@cvtreq}{\@dottedtocline{1}{0em}{7em}}
\newcommand{\listofrequirements}{%
  \chapter*{List of requirements}%
  \phantomsection
  \addcontentsline{toc}{chapter}{List of requirements}%
  \@starttoc{req}}
\newenvironment{information}
  {\begin{cvt@notebox}\textbf{Information.}\ }{\end{cvt@notebox}}
\newenvironment{rationale}
  {\begin{cvt@rationalebox}\textbf{Rationale.}\ }{\end{cvt@rationalebox}}

% ---- Listings --------------------------------------------------------
\lstdefinelanguage{SystemVerilog}{%
  morekeywords={module,endmodule,input,output,inout,logic,wire,reg,assign,
    always,always_ff,always_comb,always_latch,posedge,negedge,begin,end,if,
    else,case,casez,endcase,default,for,generate,endgenerate,genvar,
    parameter,localparam,typedef,struct,enum,packed,package,endpackage,
    import,interface,endinterface,modport,function,endfunction,task,
    endtask,return,unique,priority,automatic,int,bit,byte,integer,signed,
    unsigned,assert,property,sequence,initial,ifdef,ifndef,endif,define,
    include,timescale},
  sensitive=true,morecomment=[l]{//},morecomment=[s]{/*}{*/},
  morestring=[b]"}
\lstdefinelanguage{YAML}{%
  morekeywords={true,false,null},sensitive=true,morecomment=[l]{\#},
  morestring=[b]",morestring=[b]'}
\lstdefinestyle{cvtstyle}{%
  basicstyle=\ttfamily\footnotesize,columns=fixed,keepspaces=true,
  breaklines=true,breakatwhitespace=false,upquote=true,showstringspaces=false,
  keywordstyle=\bfseries\color{blue!45!black},
  commentstyle=\itshape\color{green!35!black},
  stringstyle=\color{red!45!black},
  frame=single,rulecolor=\color{black!30},framesep=3pt,
  xleftmargin=3pt,xrightmargin=3pt,aboveskip=0.6\baselineskip,
  belowskip=0.4\baselineskip,tabsize=2}
\lstset{style=cvtstyle,language=SystemVerilog}
\newcommand{\cvtlang}[2]{\lstdefinestyle{#1}{style=cvtstyle,language=#2}}
% Code with non-ASCII characters (diagrams). Listings sets such a character before
% the text that precedes it, so this block uses fancyvrb. Columns stay fixed.
\DefineVerbatimEnvironment{textblock}{Verbatim}{%
  fontsize=\footnotesize,breaklines=true,breakanywhere=true,
  frame=single,framesep=3pt,rulecolor=\color{black!30}}
% Verbatim tool logs with long-line breaking.
\DefineVerbatimEnvironment{logblock}{Verbatim}{%
  fontsize=\scriptsize,breaklines=true,breakanywhere=true,
  frame=lines,framesep=2mm,rulecolor=\color{black!30}}

% ---- Tables as row blocks ----------------------------------------------
% A longtable cannot break a row across pages. A table whose rows can be taller than
% the page is therefore written as row blocks (tools/docs/md2tex.py chooses). A line
% (\rowcolumns) lists the columns of the original table once. Each row has a bold
% title (\rowtitle) and one entry per column (rowcell, with the column header as its
% argument). A row breaks across pages after any entry.
\NewDocumentEnvironment{rowtable}{}
  {\par\addvspace{0.4\baselineskip}\small}
  {\par\addvspace{0.4\baselineskip}}
\NewDocumentCommand{\rowcolumns}{m}
  {\par\noindent{\footnotesize\color{black!65}Columns of the original table: #1.}\par}
\NewDocumentCommand{\rowtitle}{m}
  {\par\addvspace{0.8\baselineskip}\nobreak
   {\color{black!35}\noindent\rule{\linewidth}{0.4pt}}\par\nobreak\vspace{2pt}%
   \noindent\textbf{#1}\par\nobreak\vspace{1pt}}
\NewDocumentEnvironment{rowcell}{m}
  {\par\noindent\hangindent=1.2em\hangafter=1 \textbf{#1:}\ \ignorespaces}
  {\par}

% ---- Indexes ---------------------------------------------------------
\makeindex[name=\cvtbeadindex,title={Bead index},columns=2]
% An index that runs over a page makes multicol report "Overfull \vbox ... while \output
% is active" (a column box up to 16 pt too high; the pages look right). The build gate
% for tall table rows ignores that line inside an index file (tools/docs/build_books.py).

% ---- Longtable page break --------------------------------------------
% Longtable ends a page with \vss, which shrinks without limit. LaTeX 2025 splits
% the page box to read its marks and reports an error for that glue. The output
% routine of longtable uses a finite shrink instead. The patch is needed on the
% 2025-11-01 kernel and later. It is not applied on an earlier kernel.
% A table row that is taller than the page must not be a longtable row at all; the
% converter writes such a table as row blocks (see "Tables as row blocks" above).
\IfFormatAtLeastTF{2025-11-01}{%
  \let\cvt@LT@output\LT@output
  \def\LT@output{\def\vss{\vskip\z@\@plus1fil\relax}\cvt@LT@output}%
}{}
\endinput
