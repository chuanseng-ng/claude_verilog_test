\definecolor{cvtpartial}{HTML}{8D6E00}
\definecolor{cvtnote}{HTML}{455A64}
\definecolor{cvtopen}{HTML}{6A1B9A}
\newcommand{\cvttag}[2]{%
  \begingroup\setlength{\fboxsep}{1.2pt}\setlength{\fboxrule}{0.5pt}%
  \mbox{\fcolorbox{#1}{white}{\textcolor{#1}{\sffamily\bfseries\scriptsize
  \strut\,#2\,}}}\endgroup}
\newcommand{\warn}{\cvttag{cvtwarn}{WARNING}}
\newcommand{\ok}{\cvttag{cvtok}{OK}}
\newcommand{\bad}{\cvttag{cvtbad}{FAIL}}
\newcommand{\hold}{\cvttag{cvthold}{ON HOLD}}
