% cvtmacros.sty - macros and environments shared by the four project books.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvtmacros}[2000/01/01 Project documentation macros]
\RequirePackage{xparse}
\RequirePackage{mdframed}
\RequirePackage{amssymb}

