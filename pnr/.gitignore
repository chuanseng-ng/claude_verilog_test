# Ignore intermediate build artifacts
work/
logs/
reports/
results/
openlane/runs/
openlane1/runs/
openlane1/rtl/
librelane/runs/

# But keep directory structure
!work/.gitkeep
!logs/.gitkeep
!reports/.gitkeep
!results/.gitkeep

# Ignore specific file types
*.log
*.rpt
*.def
*.lef
*.spef
*.sdf
*.v.gz
*.nl.v
*.gds
*.oas

# Macro hard-views are committed; raw .nl.v stays ignored
!asap7/cpu/macro/*.lef
!asap7/gpu/macro/*.lef
!asap7/cpu/macro/*.nl.v.gz
!asap7/gpu/macro/*.nl.v.gz

# Keep template/example files
!*.template
!*_example.*

# Generated yosys schematics (make schematic)
asap7/schematics/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
