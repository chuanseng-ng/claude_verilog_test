                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        }
        internal_power(){
            when : "(! (web0) )";
            rise_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
        internal_power(){
            when : "(web0)";
            rise_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
