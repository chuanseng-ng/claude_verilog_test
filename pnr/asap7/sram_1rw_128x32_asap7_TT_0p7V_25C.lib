                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        } 
        timing() {
            related_pin     : clk0;
            timing_type     : hold_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
