library(sram_1rw_128x32_asap7) {
    technology (cmos);
    delay_model : table_lookup;
    revision : 1.0;
    date : "2023-08-15 21:29:36Z";
    comment : "SRAM — adapted from ORFS fakeram7_256x32 for sram_1rw_128x32_asap7 port names";
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1uA";
    leakage_power_unit : "1uW";
    nom_process : 1;
    nom_temperature : 25.000;
    nom_voltage : 0.7;
    capacitive_load_unit (1,pf);

    pulling_resistance_unit : "1kohm";

    operating_conditions(tt_1.0_25.0) {
        process : 1;
        temperature : 25.000;
        voltage : 0.7;
        tree_type : balanced_tree;
    }

    /* default attributes */
    default_cell_leakage_power : 0;
    default_fanout_load : 1;
    default_inout_pin_cap : 0.0;
    default_input_pin_cap : 0.0;
    default_output_pin_cap : 0.0;
    default_max_transition : 0.227;

    default_operating_conditions : tt_1.0_25.0;
    default_leakage_power_density : 0.0;

    /* additional header data */
    slew_derate_from_library : 1.000;
    slew_lower_threshold_pct_fall : 20.000;
    slew_upper_threshold_pct_fall : 80.000;
    slew_lower_threshold_pct_rise : 20.000;
    slew_upper_threshold_pct_rise : 80.000;
    input_threshold_pct_fall : 50.000;
    input_threshold_pct_rise : 50.000;
    output_threshold_pct_fall : 50.000;
    output_threshold_pct_rise : 50.000;


    lu_table_template(sram_1rw_128x32_asap7_mem_out_delay_template) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
            index_1 ("1000, 1001");
            index_2 ("1000, 1001");
    }
    lu_table_template(sram_1rw_128x32_asap7_mem_out_slew_template) {
        variable_1 : total_output_net_capacitance;
            index_1 ("1000, 1001");
    }
    lu_table_template(sram_1rw_128x32_asap7_constraint_template) {
        variable_1 : related_pin_transition;
        variable_2 : constrained_pin_transition;
            index_1 ("1000, 1001");
            index_2 ("1000, 1001");
    }
    power_lut_template(sram_1rw_128x32_asap7_energy_template_clkslew) {
        variable_1 : input_transition_time;
            index_1 ("1000, 1001");
    }
    power_lut_template(sram_1rw_128x32_asap7_energy_template_sigslew) {
        variable_1 : input_transition_time;
            index_1 ("1000, 1001");
    }
    library_features(report_delay_calculation);
    type (sram_1rw_128x32_asap7_DATA) {
        base_type : array ;
        data_type : bit ;
        bit_width : 32;
        bit_from : 31;
        bit_to : 0 ;
        downto : true ;
    }
    type (sram_1rw_128x32_asap7_ADDRESS) {
        base_type : array ;
        data_type : bit ;
        bit_width : 7;
        bit_from : 6;
        bit_to : 0 ;
        downto : true ;
    }
cell(sram_1rw_128x32_asap7) {
    area : 351.12;
    interface_timing : true;
    memory() {
        type : ram;
        address_width : 7;
        word_width : 32;
    }
    pin(clk0)   {
        direction : input;
        capacitance : 0.025;
        clock : true;
        min_period           : 0.157 ;
        internal_power(){
            rise_power(sram_1rw_128x32_asap7_energy_template_clkslew) {
                index_1 ("0.009, 0.227");
                values ("1.345, 1.345")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_clkslew) {
                index_1 ("0.009, 0.227");
                values ("1.345, 1.345")
            }
        }
    }

    bus(dout0)   {
        bus_type : sram_1rw_128x32_asap7_DATA;
        direction : output;
        max_capacitance : 0.500;
        memory_read() {
            address : addr0;
        }
        timing() {
            related_pin : "clk0" ;
            timing_type : rising_edge;
            timing_sense : non_unate;
            cell_rise(sram_1rw_128x32_asap7_mem_out_delay_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.005, 0.500");
                values ( \
                  "0.218, 0.218", \
                  "0.218, 0.218" \
                )
            }
            cell_fall(sram_1rw_128x32_asap7_mem_out_delay_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.005, 0.500");
                values ( \
                  "0.218, 0.218", \
                  "0.218, 0.218" \
                )
            }
            rise_transition(sram_1rw_128x32_asap7_mem_out_slew_template) {
                index_1 ("0.005, 0.500");
                values ("0.009, 0.227")
            }
            fall_transition(sram_1rw_128x32_asap7_mem_out_slew_template) {
                index_1 ("0.005, 0.500");
                values ("0.009, 0.227")
            }
        }
    }
    pin(web0){
        direction : input;
        capacitance : 0.005;
        timing() {
            related_pin : clk0;
            timing_type : setup_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        } 
        timing() {
            related_pin : clk0;
            timing_type : hold_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        }
        internal_power(){
            rise_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
    }
    pin(csb0){
        direction : input;
        capacitance : 0.005;
        timing() {
            related_pin : clk0;
            timing_type : setup_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        } 
        timing() {
            related_pin : clk0;
            timing_type : hold_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        }
        internal_power(){
            rise_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
    }
    bus(addr0)   {
        bus_type : sram_1rw_128x32_asap7_ADDRESS;
        direction : input;
        capacitance : 0.005;
        timing() {
            related_pin : clk0;
            timing_type : setup_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        } 
        timing() {
            related_pin : clk0;
            timing_type : hold_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
            fall_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
                  "0.050, 0.050" \
                )
            }
        }
        internal_power(){
            rise_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(sram_1rw_128x32_asap7_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
    }
    bus(din0)   {
        bus_type : sram_1rw_128x32_asap7_DATA;
        memory_write() {
            address : addr0;
            clocked_on : "clk0";
        }
        direction : input;
        capacitance : 0.005;
        timing() {
            related_pin     : clk0;
            timing_type     : setup_rising ;
            rise_constraint(sram_1rw_128x32_asap7_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
