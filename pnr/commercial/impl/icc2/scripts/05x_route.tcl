# 05x_route.tcl -- Step B5e routing variant (global-route effort/macro-boundary + partition options; li1 stays banned): derived from 05_route.tcl stage 5: antenna rules, input-port protection diodes, route_auto, route_opt, DRC/LVS/antenna checks.
#   met1..met4 only (set_ignored_layers), antenna rules executed from sky130_tech_setup.tcl (tech-LEF ANTENNAMODEL), diode = sky130_fd_sc_hd__diode_2.
source [file join [file dirname [info script]] common.tcl]
set t0 [clock seconds]
open_stage 04_cts 05x_route
source [file join $SCRIPTDIR reload.tcl]
# ---- B5e variant options (routing-only; nothing in placement/CTS/timing constraints changes)
set_app_options -name route.global.effort_level -value high
set_app_options -name route.global.macro_boundary_track_utilization -value 60
set_app_options -name route.detail.optimize_partition_size_for_drc -value true
foreach o {route.global.effort_level route.global.macro_boundary_track_utilization route.detail.optimize_partition_size_for_drc route.common.global_min_layer_mode} { puts "OPT $o = [get_app_option_value -name $o]" }
# ---- antenna: the proc generated by gen_techfile.py (sky130_antenna_rules) is rejected by ICC2 (-diode_ratio PWL pairs are not a valid vector), so
#      scripts/antenna_rules.tcl defines the same ratios with diode_mode 1
source [file join $SCRIPTDIR antenna_rules.tcl]
redirect -file $RUN/reports/antenna_rules.txt { report_antenna_rules }
set_app_options -name route.detail.antenna -value true
set_app_options -name route.detail.antenna_fixing_preference -value use_diodes
set_app_options -name route.detail.diode_libcell_names -value {sky130_fd_sc_hd__diode_2}
# DIODE_ON_PORTS=in: protection diode on every input port except the clock
set in_ports [remove_from_collection [get_ports -filter "direction==in"] [get_ports clk_i]]
add_port_protection_diodes -diode_lib_cell [get_lib_cells */sky130_fd_sc_hd__diode_2] -port $in_ports -prefix PORTDIODE_
puts "PORT DIODES: [sizeof_collection [get_cells -quiet -hier -filter {ref_name==sky130_fd_sc_hd__diode_2}]]"
catch {legalize_placement}
set t1 [clock seconds]
route_auto
stage_time route_auto $t1
save_block
redirect -file $RUN/reports/route_auto_checks.txt { check_routes }
set t2 [clock seconds]
route_opt
stage_time route_opt $t2
redirect -file $RUN/reports/route_checks.txt { check_routes -drc true -antenna true -open_net true }
redirect -file $RUN/reports/route_lvs.txt { check_lvs -checks all -max_errors 0 }
redirect -file $RUN/reports/route_qor.txt { report_qor -summary; report_qor }
redirect -file $RUN/reports/route_timing.txt { report_timing -max_paths 5 -delay_type max; report_timing -max_paths 5 -delay_type min }
save_stage 05x_route
stage_time route $t0
exit
