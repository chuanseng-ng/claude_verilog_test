# DERIVED by scripts/mk_ict_li1m1.py from sky130A_nom.ict: conductor li1 renamed met0 (Innovus capTable layer order M1=li1..M6=met5)
# ====================================================================================
# Sky130A interconnect ICT -- corner nom -- INDICATIVE, AUTHORED (no foundry ICT ships with Sky130)
# generated by scripts/gen_stack.py ; sources: [FIG] [TLEF] [MAGIC] [FIT] [ORCX] [DRM] (see docstring)
# ER corner multiplier 1.0000 [ORCX]; sheet/contact R corner [TLEF]/[MAGIC] nom.
# Heights are absolute (z from substrate reference).  Planar dielectrics laterally intersect conductors.
# ====================================================================================
process "sky130A_nom" {
    background_dielectric_constant 1.0
    temp_reference 25
}
# wells are not declared: Techgen ignores the well statement (warns) and Quantus does not use it at runtime.

# top at poly bottom [MAGIC alldiff]; Rsq [MAGIC] n+ ; TC [ABSENT]
diffusion "ndiff" {
    thickness 0.3221
    resistivity 120.0
}
# Rsq [MAGIC] p+
diffusion "pdiff" {
    thickness 0.3221
    resistivity 197.0
}

conductor "poly" {
    min_spacing 0.21
    min_width 0.15
    height 0.3262
    thickness 0.18
    resistivity 48.2
    gate_forming_layer true
}
conductor "met0" {
    min_spacing 0.17
    min_width 0.17
    height 0.9361
    thickness 0.1
    resistivity 12.8
    gate_forming_layer false
}
conductor "met1" {
    min_spacing 0.14
    min_width 0.14
    height 1.3761
    thickness 0.36
    resistivity 0.125
    gate_forming_layer false
}
conductor "met2" {
    min_spacing 0.14
    min_width 0.14
    height 2.0061
    thickness 0.36
    resistivity 0.125
    gate_forming_layer false
}
conductor "met3" {
    min_spacing 0.3
    min_width 0.3
    height 2.7861
    thickness 0.845
    resistivity 0.047
    gate_forming_layer false
}
conductor "met4" {
    min_spacing 0.3
    min_width 0.3
    height 4.0211
    thickness 0.845
    resistivity 0.047
    gate_forming_layer false
}
conductor "met5" {
    min_spacing 1.6
    min_width 1.6
    height 5.3711
    thickness 1.26
    resistivity 0.0285
    gate_forming_layer false
}

# FIG FOX K=3.9
dielectric "FOX" {
    conformal FALSE
    height 0.0
    thickness 0.3262
    dielectric_constant 3.9000
}
# FIG PSG K=3.9 (poly + licon level)
dielectric "PSG_poly" {
    conformal FALSE
    height 0.3262
    thickness 0.6099
    dielectric_constant 3.9000
}
# FIG PSG K=3.9 (li1 level)
dielectric "PSG_li" {
    conformal FALSE
    height 0.9361
    thickness 0.1000
    dielectric_constant 3.9000
}
# FIG LINT K=7.3, 0.075 um nitride on li1
dielectric "LINT" {
    conformal FALSE
    height 1.0361
    thickness 0.0750
    dielectric_constant 7.3000
}
# FIT (fig NILD2 K=4.05 nearest published 3.9..4.05)
dielectric "NILD2_mcon" {
    conformal FALSE
    height 1.1111
    thickness 0.2650
    dielectric_constant 3.9000
}
# FIT met1 level
dielectric "IMD1" {
    conformal FALSE
    height 1.3761
    thickness 0.3600
    dielectric_constant 3.9000
}
# FIT via1 gap (fig NILD5 K=4.1 value)
dielectric "NILD_v1" {
    conformal FALSE
    height 1.7361
    thickness 0.2700
    dielectric_constant 4.1000
}
# FIT met2 level
dielectric "IMD2" {
    conformal FALSE
    height 2.0061
    thickness 0.3600
    dielectric_constant 3.9000
}
# FIT via2 gap (fig NILD5 K=4.1 value)
dielectric "NILD_v2" {
    conformal FALSE
    height 2.3661
    thickness 0.4200
    dielectric_constant 4.1000
}
# FIT met3 level
dielectric "IMD3" {
    conformal FALSE
    height 2.7861
    thickness 0.8450
    dielectric_constant 3.9000
}
# FIT via3 gap (fig NILD4_C/NILD3_C K=3.5 value)
dielectric "NILD_v3" {
    conformal FALSE
    height 3.6311
    thickness 0.3900
    dielectric_constant 3.5000
}
# FIT met4 level (fig NILD6 K=4.0)
dielectric "IMD4" {
    conformal FALSE
    height 4.0211
    thickness 0.8450
    dielectric_constant 4.0000
}
# FIT via4 gap (fig TOPOX K=3.9)
dielectric "NILD_v4" {
    conformal FALSE
    height 4.8661
    thickness 0.5050
    dielectric_constant 3.9000
}
# FIT met5 level
dielectric "IMD5" {
    conformal FALSE
    height 5.3711
    thickness 1.2600
    dielectric_constant 3.9000
}
# FIG PI1 K=2.94, 5.2523 um (6.6311 -> 11.8834)
dielectric "PI1" {
    conformal FALSE
    height 6.6311
    thickness 5.2523
    dielectric_constant 2.9400
}

# [MAGIC] pc
via "licon" {
    top_layer met0
    bottom_layer poly
    contact_resistance 152.0
}
# [MAGIC] ndc
via "licon" {
    top_layer met0
    bottom_layer ndiff
    contact_resistance 185.0
}
# [MAGIC] pdc
via "licon" {
    top_layer met0
    bottom_layer pdiff
    contact_resistance 585.0
}
# [TLEF mcon nom], cut 0.17 um
via "mcon" {
    top_layer met1
    bottom_layer met0
    contact_resistance 9.3
}
# [TLEF via nom], cut 0.15 um
via "via1" {
    top_layer met2
    bottom_layer met1
    contact_resistance 4.5
}
# [TLEF via2 nom], cut 0.2 um
via "via2" {
    top_layer met3
    bottom_layer met2
    contact_resistance 3.41
}
# [TLEF via3 nom], cut 0.2 um
via "via3" {
    top_layer met4
    bottom_layer met3
    contact_resistance 3.41
}
# [TLEF via4 nom], cut 0.8 um
via "via4" {
    top_layer met5
    bottom_layer met4
    contact_resistance 0.38
}
