# B5d-gds fix: (a) VIA entries on every METAL layer, so via metal enclosure pads (M1M2_PR..., PG via stacks) are written, not only the cuts;
#              (b) NAME lines (Sky130 convention from ~/pdk/sky130A/libs.tech/klayout/tech/sky130A.map: pin text on datatype 5) so pin names are written as text labels.
#              The old per-layer "LABEL" lines were accepted but wrote no text and are removed.  Old map: scripts/gds_layer_map.innovus.badmap
# Innovus streamOut map: <LEF layer> <object type> <GDS layer> <datatype>.  Sky130A numbers (same source as the ICC2 arm's gds_layer_map.txt:
# ~/pdk/sky130A/libs.tech/klayout/tech/sky130A.map): drawing 20, via/cut 44, pin 16, label 5.
li1   NET     67 20
li1   SPNET   67 20
li1   PIN     67 16
li1   LEFPIN  67 20
mcon  VIA     67 44
mcon  NET     67 44
mcon  SPNET   67 44
met1  NET     68 20
met1  SPNET   68 20
met1  PIN     68 16
met1  LEFPIN  68 20
via   VIA     68 44
via   NET     68 44
via   SPNET   68 44
met2  NET     69 20
met2  SPNET   69 20
met2  PIN     69 16
met2  LEFPIN  69 20
via2  VIA     69 44
via2  NET     69 44
via2  SPNET   69 44
met3  NET     70 20
met3  SPNET   70 20
met3  PIN     70 16
met3  LEFPIN  70 20
via3  VIA     70 44
via3  NET     70 44
via3  SPNET   70 44
met4  NET     71 20
met4  SPNET   71 20
met4  PIN     71 16
met4  LEFPIN  71 20
via4  VIA     71 44
via4  NET     71 44
via4  SPNET   71 44
met5  NET     72 20
met5  SPNET   72 20
met5  PIN     72 16
met5  LEFPIN  72 20

# --- via enclosure pads on every metal layer (VIA objects drawn on the metal drawing datatype)
li1   VIA     67 20
met1  VIA     68 20
met2  VIA     69 20
met3  VIA     70 20
met4  VIA     71 20
met5  VIA     72 20
# --- pin names as text on the label datatype 5 (Innovus streamOut man page: object name NAME = text label for the object types in the 2nd column; "NAME <layer>/PIN" labels top-level IO pins.
#  The PDK sky130A.map form "NAME <layer>/LABEL,<layer>/LEFPIN" wrote no text for design pins)
NAME  li1/PIN  67 5
NAME  met1/PIN  68 5
NAME  met2/PIN  69 5
NAME  met3/PIN  70 5
NAME  met4/PIN  71 5
NAME  met5/PIN  72 5
