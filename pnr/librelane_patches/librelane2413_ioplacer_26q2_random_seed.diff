--- a/librelane/scripts/openroad/ioplacer.tcl
+++ b/librelane/scripts/openroad/ioplacer.tcl
@@ -40,8 +40,16 @@
 }
 
 set arg_list [list]
+# claude_verilog_test local patch (2026-09-13): OpenROAD 26Q2 (shimmed into this 2.4.13 flow
+# by pnr/Makefile check-asap7-openroad) treats BOTH -random and -random_seed as obsolete:
+#   [WARNING PPL-0113] -random and -random_seed are obsolete. Skipping random pin placement.
+# and then places NO pins at all -- global placement later dies with
+#   [ERROR GPL-0326] <port> toplevel port is not placed.
+# 26Q2 has no random-equidistant mode, so FP_PPL_MODE=random_equidistant now falls back to the
+# default (optimised) placement, matching LibreLane 3.0.14's ioplacer.tcl, which never passes
+# either flag.
 if { $::env(FP_PPL_MODE) == "random_equidistant" } {
-	lappend arg_list -random
+	puts "\[WARNING\] FP_PPL_MODE=random_equidistant is not supported by this OpenROAD; using default pin placement."
 }
 
 if { [info exists ::env(FP_IO_MIN_DISTANCE)] } {
@@ -57,7 +65,6 @@
 
 puts "\[INFO\] place_pins args: $arg_list"
 place_pins {*}$arg_list \
-	-random_seed 42 \
 	-hor_layers $HMETAL \
 	-ver_layers $VMETAL
 
