+/// Read a network in .blif format, also returning the signal of every named net in the final (sorted) network
+pub fn read_blif_named<R: std::io::Read>(
+    r: R,
+) -> Result<(Network, HashMap<String, Signal>), String> {
+    let statements = read_statements(r)?;
+    let name_to_sig = build_name_to_sig(&statements)?;
+    let (aig, t) = build_network_translated(&statements, &name_to_sig)?;
+    let names = name_to_sig
+        .into_iter()
+        .map(|(k, s)| {
+            let s2 = if s.is_var() { s.remap_order(&t) } else { s };
+            (k, s2)
+        })
+        .collect();
+    Ok((aig, names))
+}
