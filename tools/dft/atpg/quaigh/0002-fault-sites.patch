 use crate::sim::{detects_faults, detects_faults_multi, Fault};
 use crate::{Gate, Network, Signal};
 
+/// Build the fault list of a fault-site file: one net name per line, each the output of a buffer
+/// (a cell pin), giving its output stuck-at-0 and stuck-at-1 faults.  No fault collapsing.
+/// Panics if a name is unknown, inverted, not a gate, or not a buffer: a silently shorter list would
+/// inflate coverage.
+pub fn fault_sites_from_names(
+    aig: &Network,
+    names: &std::collections::HashMap<String, Signal>,
+    sites: &str,
+) -> Vec<Fault> {
+    let mut ret = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for line in sites.lines() {
+        let n = line.trim();
+        if n.is_empty() {
+            continue;
+        }
+        let s = *names
+            .get(n)
+            .unwrap_or_else(|| panic!("fault site {} is not a net of the network", n));
+        assert!(
+            s.is_var() && !s.is_inverted(),
+            "fault site {} is not a plain gate output",
+            n
+        );
+        let gate = s.var() as usize;
+        assert!(
+            matches!(aig.gate(gate), Gate::Buf(_)),
+            "fault site {} is not a buffer: {:?}",
+            n,
+            aig.gate(gate)
+        );
+        assert!(seen.insert(gate), "fault site {} listed twice", n);
+        for value in [false, true] {
+            ret.push(Fault::OutputStuckAtFault { gate, value });
+        }
+    }
+    ret
+}
